{
  "name": "nestjs-config-extended",
  "version": "1.2.7",
  "description": "Extended configuration module for NestJS: load, validate, reload and inject configuration from environment variables, .env, JSON, YAML or custom sources.",
  "author": "Pedro Sodré",
  "license": "MIT",
  "homepage": "https://github.com/pedrosodre/nestjs-config-extended#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosodre/nestjs-config-extended.git"
  },
  "bugs": {
    "url": "https://github.com/pedrosodre/nestjs-config-extended/issues"
  },
  "keywords": [
    "nestjs",
    "nest",
    "config",
    "configuration",
    "env",
    "dotenv",
    "environment-variables",
    "yaml",
    "json",
    "schema",
    "zod",
    "standard-schema",
    "secrets"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.mjs",
    "index.d.mts",
    "llms.txt"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "semantic-release": "semantic-release",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "husky",
    "lint:package": "publint --strict && attw --pack .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run api:check && npm run lint:package && npm run test:compat",
    "test:compat": "node tests/compat/runtime.cjs && node tests/compat/runtime.mjs",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "dotenv-expand": "12.0.3",
    "lodash.get": "4.4.2",
    "lodash.has": "4.5.2",
    "lodash.isfunction": "^3.0.9",
    "node-cron": "4.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "9.39.5",
    "@microsoft/api-extractor": "7.60.1",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/testing": "11.2.8",
    "@types/jest": "29.5.14",
    "@types/lodash.get": "4.4.9",
    "@types/lodash.has": "4.5.9",
    "@types/lodash.isfunction": "^3.0.6",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semantic-release": "25.0.9",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1 || ^0.2",
    "rxjs": "^7.2.0",
    "yaml": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "./lib/**/*.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 75,
        "functions": 85,
        "lines": 90
      }
    }
  },
  "lint-staged": {
    "*.{ts,mts,cts,mjs,cjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "@microsoft/api-extractor": {
      "minimatch": "11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  }
}
