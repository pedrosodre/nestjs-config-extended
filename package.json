{
  "name": "nestjs-config-extended",
  "version": "1.2.7",
  "description": "Extended Configuration Module for Nest to load environment variables package",
  "author": "Pedro Sodré",
  "license": "MIT",
  "url": "https://github.com/pedrosodre/nestjs-config-extended",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.mjs"
  ],
  "scripts": {
    "build": "rimraf -rf dist && tsc -p tsconfig.json",
    "lint": "tslint -c tslint.json 'lib/**/*.ts'",
    "format": "prettier --write \"lib/**/*.ts\" \"tests/**/*.ts\"",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "prerelease": "npm run build",
    "release": "npm publish --access=public",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "dotenv": "8.2.0",
    "dotenv-expand": "12.0.3",
    "lodash.get": "4.4.2",
    "lodash.has": "4.5.2",
    "lodash.isfunction": "^3.0.9",
    "node-cron": "^2.0.3",
    "rxjs": "^7.2.0",
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/testing": "11.2.8",
    "@types/jest": "29.5.14",
    "@types/lodash.get": "4.4.6",
    "@types/lodash.has": "4.5.6",
    "@types/lodash.isfunction": "^3.0.6",
    "@types/lodash.set": "4.3.6",
    "@types/node": "20.19.43",
    "@types/node-cron": "^2.0.3",
    "@types/uuid": "8.3.0",
    "husky": "4.3.7",
    "jest": "29.7.0",
    "prettier": "2.2.1",
    "reflect-metadata": "0.1.13",
    "rimraf": "3.0.2",
    "semantic-release": "^19.0.3",
    "ts-jest": "29.4.15",
    "tslint": "^6.1.3",
    "typescript": "5.9.3",
    "yaml": "2.8.4"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1 || ^0.2",
    "rxjs": "^7.2.0",
    "yaml": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "./lib/**/*.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrosodre/nestjs-config-extended"
  }
}
