{
  "name": "nestjs-config-extended",
  "version": "1.2.7",
  "description": "Extended Configuration Module for Nest to load environment variables package",
  "author": "Pedro Sodré",
  "license": "MIT",
  "type": "commonjs",
  "url": "https://github.com/pedrosodre/nestjs-config-extended",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.mjs",
    "index.d.mts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "prerelease": "npm run build",
    "release": "npm publish --access=public",
    "semantic-release": "semantic-release",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "husky",
    "lint:package": "publint --strict && attw --pack .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run lint:package && npm run test:compat",
    "test:compat": "node tests/compat/runtime.cjs && node tests/compat/runtime.mjs"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "dotenv-expand": "12.0.3",
    "lodash.get": "4.4.2",
    "lodash.has": "4.5.2",
    "lodash.isfunction": "^3.0.9",
    "node-cron": "^2.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "9.39.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/testing": "11.2.8",
    "@types/jest": "29.5.14",
    "@types/lodash.get": "4.4.6",
    "@types/lodash.has": "4.5.6",
    "@types/lodash.isfunction": "^3.0.6",
    "@types/node": "20.19.43",
    "@types/node-cron": "^2.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.2",
    "semantic-release": "^19.0.3",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.8.4"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1 || ^0.2",
    "rxjs": "^7.2.0",
    "yaml": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "./lib/**/*.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 75,
        "functions": 85,
        "lines": 90
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrosodre/nestjs-config-extended"
  },
  "lint-staged": {
    "*.{ts,mts,cts,mjs,cjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
